{
  "entities": {
    "faculty": {
      "title": "Faculty Directory",
      "description": "Registered faculty accounts and details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "department": { "type": "string" },
        "advisoryRole": {
          "type": "string",
          "enum": ["Class Adviser", "Non-Adviser"]
        },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "admins": {
      "title": "Admin Directory",
      "description": "Registered administrator accounts and details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "designation": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "facultyRequests": {
      "title": "Faculty Registration Requests",
      "description": "Pending requests for faculty account creation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "department": { "type": "string" },
        "requestedAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "adminRequests": {
      "title": "Admin Registration Requests",
      "description": "Pending requests for admin account creation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "designation": { "type": "string" },
        "requestedAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "userPasswords": {
      "title": "User Passwords",
      "description": "Encrypted or stored credentials for registered users",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "password"]
    },
    "settings": {
      "title": "System Settings",
      "description": "Master passwords and global configurations",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["key", "value"]
    },
    "announcements": {
      "title": "Announcements",
      "description": "School and department notices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "priority": { "type": "string" },
        "targetAudience": { "type": "string" },
        "status": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "driveFolders": {
      "title": "Google Drive Folders",
      "description": "Configured repository folders with embedded Google Drive links",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "driveUrl": { "type": "string" },
        "driveId": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "name", "path", "driveUrl"]
    },
    "facultyFolders": {
      "title": "Faculty Personal Folders",
      "description": "Folders created by individual registered faculty members",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "facultyEmail": { "type": "string" },
        "facultyName": { "type": "string" },
        "facultySurname": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "color": { "type": "string" },
        "driveUrl": { "type": "string" },
        "driveId": { "type": "string" },
        "itemCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "facultyEmail", "facultyName", "name"]
    },
    "facultyFiles": {
      "title": "Faculty Personal Files",
      "description": "Files and links uploaded inside faculty personal folders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "folderId": { "type": "string" },
        "facultyEmail": { "type": "string" },
        "facultyName": { "type": "string" },
        "title": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSizeBytes": { "type": "number" },
        "fileSizeFormatted": { "type": "string" },
        "format": { "type": "string" },
        "category": { "type": "string" },
        "driveUrl": { "type": "string" },
        "isGoogleDriveLink": { "type": "boolean" },
        "uploadedAt": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "folderId", "facultyEmail", "title", "fileName"]
    },
    "facultySubmissions_dll": {
      "title": "Faculty DLL Submissions",
      "description": "Weekly Daily Lesson Log submission checklist records per term",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "termId": { "type": "string" },
        "category": { "type": "string" },
        "facultyEmail": { "type": "string" },
        "facultyName": { "type": "string" },
        "department": { "type": "string" },
        "weeks": {
          "type": "array",
          "items": { "type": "boolean" }
        },
        "statuses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "comments": {
          "type": "object"
        },
        "lastSavedWeek": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "termId", "facultyEmail", "weeks"]
    },
    "facultySubmissions_tos": {
      "title": "Faculty TOS Submissions",
      "description": "Table of Specifications submission checklist records per term",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "termId": { "type": "string" },
        "category": { "type": "string" },
        "facultyEmail": { "type": "string" },
        "facultyName": { "type": "string" },
        "department": { "type": "string" },
        "weeks": {
          "type": "array",
          "items": { "type": "boolean" }
        },
        "statuses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "comments": {
          "type": "object"
        },
        "lastSavedWeek": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "termId", "facultyEmail", "weeks"]
    },
    "facultySubmissions_tq": {
      "title": "Faculty TQ Submissions",
      "description": "Test Questions submission checklist records per term",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "termId": { "type": "string" },
        "category": { "type": "string" },
        "facultyEmail": { "type": "string" },
        "facultyName": { "type": "string" },
        "department": { "type": "string" },
        "weeks": {
          "type": "array",
          "items": { "type": "boolean" }
        },
        "statuses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "comments": {
          "type": "object"
        },
        "lastSavedWeek": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "termId", "facultyEmail", "weeks"]
    },
    "schoolPermanentFolders": {
      "title": "School Permanent Folders",
      "description": "Permanent school-wide folders (SCHOOL FORMS and SCHOOL DOCUMENTS) configured by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "driveUrl": { "type": "string" },
        "driveId": { "type": "string" },
        "category": { "type": "string" },
        "color": { "type": "string" },
        "isPermanent": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "name", "driveUrl", "isPermanent"]
    },
    "passwordResetRequests": {
      "title": "Password Reset Requests",
      "description": "User password reset requests using temporary password awaiting Master Admin approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "requestedNewPassword": { "type": "string" },
        "requestedAt": { "type": "string" },
        "status": { "type": "string" },
        "reviewedAt": { "type": "string" },
        "reviewedBy": { "type": "string" }
      },
      "required": ["id", "email", "requestedNewPassword", "status"]
    },
    "classAdviserSchoolForms": {
      "title": "Class Adviser School Forms",
      "description": "School Forms SF 1, 3, 4, 5, 6, 8, 10 and SF 2 Monthly compliance checklist for designated Class Advisers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "facultyEmail": { "type": "string" },
        "facultyName": { "type": "string" },
        "department": { "type": "string" },
        "sf1": { "type": "boolean" },
        "sf3": { "type": "boolean" },
        "sf4": { "type": "boolean" },
        "sf5": { "type": "boolean" },
        "sf6": { "type": "boolean" },
        "sf8": { "type": "boolean" },
        "sf10": { "type": "boolean" },
        "sf2_june": { "type": "boolean" },
        "sf2_july": { "type": "boolean" },
        "sf2_august": { "type": "boolean" },
        "sf2_september": { "type": "boolean" },
        "sf2_october": { "type": "boolean" },
        "sf2_november": { "type": "boolean" },
        "sf2_december": { "type": "boolean" },
        "sf2_january": { "type": "boolean" },
        "sf2_february": { "type": "boolean" },
        "sf2_march": { "type": "boolean" },
        "sf2_april": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["facultyEmail"]
    },
    "gallery_photos": {
      "title": "Login Gallery Photos",
      "description": "Showcase pictures displayed on the auto-swiping login page gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "caption": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "url", "title"]
    },
    "embedded_videos": {
      "title": "Embedded Videos",
      "description": "HTML or iframe embedded videos provided by Master Admin displayed on the Login View",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "embedCode": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "embedCode"]
    }
  },
  "firestore": {
    "/gallery_photos/{photoId}": {
      "schema": "gallery_photos",
      "description": "Public and administrative photos shown in the login screen auto-swiping gallery"
    },
    "/embedded_videos/{videoId}": {
      "schema": "embedded_videos",
      "description": "Embedded videos provided by Master Admin shown on the Login View"
    }
  }
}
